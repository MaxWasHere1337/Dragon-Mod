{
  "format_version": "1.21.90",
  "minecraft:entity": {
    "description": {
      "identifier": "dragonmod:forest_dragon",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "components": {
      "minecraft:type_family": { "family": [ "dragon", "forest_dragon", "mob" ] },
      "minecraft:collision_box": { "width": 1.5, "height": 1.5 },
      "minecraft:health": { "value": 40, "max": 40 },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": { "can_path_over_water": true, "avoid_damage_blocks": true },
      "minecraft:jump.static": {},
      "minecraft:nameable": {},
      "minecraft:leashable": {},
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:ambient_sound_interval": { "value": 12, "range": 16 },
      "minecraft:damage_sensor": {
        "triggers": [ { "cause": "fall", "deals_damage": "no" } ]
      },
      "minecraft:healable": {
        "items": [
          { "item": "apple", "heal_amount": 4 },
          { "item": "sweet_berries", "heal_amount": 2 },
          { "item": "melon_slice", "heal_amount": 2 },
          { "item": "golden_apple", "heal_amount": 10 }
        ]
      },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.tempt": {
        "priority": 4,
        "speed_multiplier": 1.2,
        "items": [ "apple", "sweet_berries", "melon_slice", "glow_berries", "golden_apple" ]
      },
      "minecraft:behavior.random_stroll": { "priority": 7, "speed_multiplier": 0.8 },
      "minecraft:behavior.look_at_player": { "priority": 8, "look_distance": 8.0 },
      "minecraft:behavior.random_look_around": { "priority": 9 }
    },
    "component_groups": {
      "dragonmod:grounded": {
        "minecraft:physics": {},
        "minecraft:movement": { "value": 0.25 }
      },
      "dragonmod:airborne": {
        "minecraft:physics": { "has_gravity": false },
        "minecraft:can_fly": {},
        "minecraft:movement": { "value": 0.045 },
        "minecraft:flying_speed": { "value": 0.045 }
      },
      "dragonmod:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": { "value": 0.4 },
        "minecraft:ageable": {
          "duration": 2400,
          "feed_items": [ "apple", "sweet_berries", "melon_slice", "glow_berries" ],
          "grow_up": { "event": "dragonmod:grow_up", "target": "self" }
        },
        "minecraft:behavior.follow_parent": { "priority": 6, "speed_multiplier": 1.1 }
      },
      "dragonmod:adult": {
        "minecraft:experience_reward": {
          "on_bred": "Math.Random(1,7)",
          "on_death": "query.last_hit_by_player ? Math.Random(3,6) : 0"
        },
        "minecraft:breedable": {
          "require_tame": true,
          "breeds_with": {
            "mate_type": "dragonmod:forest_dragon",
            "baby_type": "dragonmod:forest_dragon",
            "breed_event": { "event": "minecraft:entity_born", "target": "baby" }
          },
          "breed_items": [ "golden_apple", "glow_berries" ]
        },
        "minecraft:behavior.breed": { "priority": 3, "speed_multiplier": 1.0 }
      },
      "dragonmod:wild": {
        "minecraft:tameable": {
          "probability": 0.34,
          "tame_items": [ "apple", "sweet_berries", "melon_slice" ],
          "tame_event": { "event": "dragonmod:on_tame", "target": "self" }
        },
        "minecraft:behavior.panic": { "priority": 1, "speed_multiplier": 1.5 }
      },
      "dragonmod:tamed": {
        "minecraft:is_tamed": {},
        "minecraft:persistent": {},
        "minecraft:behavior.follow_owner": {
          "priority": 5,
          "speed_multiplier": 1.2,
          "start_distance": 10,
          "stop_distance": 3
        }
      },
      "dragonmod:saddleable": {
        "minecraft:interact": {
          "interactions": [
            {
              "on_interact": {
                "filters": { "test": "has_equipment", "subject": "other", "domain": "hand", "value": "saddle" },
                "event": "dragonmod:on_saddled",
                "target": "self"
              },
              "use_item": true,
              "swing": true,
              "play_sounds": [ "saddle" ],
              "interact_text": "action.interact.saddle"
            }
          ]
        }
      },
      "dragonmod:saddled": {
        "minecraft:is_saddled": {},
        "minecraft:rideable": {
          "seat_count": 1,
          "family_types": [ "player" ],
          "crouching_skip_interact": true,
          "interact_text": "action.interact.ride.horse",
          "on_rider_enter_event": "dragonmod:rider_enter",
          "on_rider_exit_event": "dragonmod:rider_exit",
          "seats": { "position": [ 0.0, 1.2, 0.0 ] }
        },
        "minecraft:free_camera_controlled": {
          "strafe_speed_modifier": 1.0,
          "backwards_movement_modifier": 0.5
        },
        "minecraft:vertical_movement_action": { "vertical_velocity": 0.5 },
        "minecraft:behavior.player_ride_tamed": { "priority": 0 }
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          { "add": { "component_groups": [ "dragonmod:grounded", "dragonmod:wild" ] } },
          {
            "randomize": [
              { "weight": 85, "add": { "component_groups": [ "dragonmod:adult" ] } },
              { "weight": 15, "add": { "component_groups": [ "dragonmod:baby" ] } }
            ]
          }
        ]
      },
      "minecraft:entity_born": {
        "add": { "component_groups": [ "dragonmod:grounded", "dragonmod:baby", "dragonmod:tamed" ] }
      },
      "dragonmod:hatched": {
        "add": { "component_groups": [ "dragonmod:grounded", "dragonmod:baby", "dragonmod:wild" ] }
      },
      "dragonmod:on_tame": {
        "sequence": [
          {
            "remove": { "component_groups": [ "dragonmod:wild" ] },
            "add": { "component_groups": [ "dragonmod:tamed" ] }
          },
          {
            "filters": { "test": "has_component", "operator": "!=", "value": "minecraft:is_baby" },
            "add": { "component_groups": [ "dragonmod:saddleable" ] }
          }
        ]
      },
      "dragonmod:grow_up": {
        "sequence": [
          {
            "remove": { "component_groups": [ "dragonmod:baby" ] },
            "add": { "component_groups": [ "dragonmod:adult" ] }
          },
          {
            "filters": { "test": "has_component", "value": "minecraft:is_tamed" },
            "add": { "component_groups": [ "dragonmod:saddleable" ] }
          }
        ]
      },
      "dragonmod:on_saddled": {
        "remove": { "component_groups": [ "dragonmod:saddleable" ] },
        "add": { "component_groups": [ "dragonmod:saddled" ] }
      },
      "dragonmod:rider_enter": {
        "sequence": [
          { "remove": { "component_groups": [ "dragonmod:grounded" ] } },
          { "add": { "component_groups": [ "dragonmod:airborne" ] } }
        ]
      },
      "dragonmod:rider_exit": {
        "sequence": [
          { "remove": { "component_groups": [ "dragonmod:airborne" ] } },
          { "add": { "component_groups": [ "dragonmod:grounded" ] } },
          { "queue_command": { "command": "effect @p[r=10] slow_falling 10 0 true" } }
        ]
      }
    }
  }
}
