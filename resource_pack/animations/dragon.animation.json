{
  "format_version": "1.8.0",
  "animations": {
    "animation.dragonmod.dragon.look_at_target": {
      "loop": true,
      "bones": {
        "head": { "rotation": [ "query.target_x_rotation * 0.6", "query.target_y_rotation * 0.6", 0 ] }
      }
    },
    "animation.dragonmod.dragon.walk": {
      "loop": true,
      "anim_time_update": "query.modified_distance_moved",
      "bones": {
        "leg_front_left": { "rotation": [ "math.cos(query.anim_time * 38.17) * 35.0", 0, 0 ] },
        "leg_front_right": { "rotation": [ "math.cos(query.anim_time * 38.17) * -35.0", 0, 0 ] },
        "leg_back_left": { "rotation": [ "math.cos(query.anim_time * 38.17) * -35.0", 0, 0 ] },
        "leg_back_right": { "rotation": [ "math.cos(query.anim_time * 38.17) * 35.0", 0, 0 ] }
      }
    },
    "animation.dragonmod.dragon.idle": {
      "loop": true,
      "bones": {
        "tail1": { "rotation": [ 0, "math.sin(query.life_time * 70.0) * 8.0", 0 ] },
        "tail2": { "rotation": [ 0, "math.sin(query.life_time * 70.0 - 40.0) * 10.0", 0 ] },
        "tail3": { "rotation": [ 0, "math.sin(query.life_time * 70.0 - 80.0) * 12.0", 0 ] },
        "neck": { "rotation": [ "math.sin(query.life_time * 50.0) * 2.0", 0, 0 ] }
      }
    },
    "animation.dragonmod.dragon.wings_folded": {
      "loop": true,
      "bones": {
        "wing_left": { "rotation": [ 0, 0, "-55.0 - math.sin(query.life_time * 60.0) * 3.0" ] },
        "wing_left_tip": { "rotation": [ 0, 0, 115.0 ] },
        "wing_right": { "rotation": [ 0, 0, "55.0 + math.sin(query.life_time * 60.0) * 3.0" ] },
        "wing_right_tip": { "rotation": [ 0, 0, -115.0 ] }
      }
    },
    "animation.dragonmod.dragon.wings_flap": {
      "loop": true,
      "bones": {
        "wing_left": { "rotation": [ 0, 0, "math.sin(query.life_time * 420.0) * -35.0" ] },
        "wing_left_tip": { "rotation": [ 0, 0, "math.sin(query.life_time * 420.0 - 50.0) * -25.0" ] },
        "wing_right": { "rotation": [ 0, 0, "math.sin(query.life_time * 420.0) * 35.0" ] },
        "wing_right_tip": { "rotation": [ 0, 0, "math.sin(query.life_time * 420.0 - 50.0) * 25.0" ] }
      }
    },
    "animation.dragonmod.dragon_egg.wobble": {
      "loop": true,
      "bones": {
        "egg": { "rotation": [ 0, 0, "math.sin(query.life_time * 900.0) * 9.0" ] }
      }
    }
  }
}
